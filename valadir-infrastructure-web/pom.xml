<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valadir</groupId>
        <artifactId>valadir</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>valadir-infrastructure-web</artifactId>

    <properties>
        <jacoco.check.phase>verify</jacoco.check.phase>
        <jacoco.check.dataFile>${project.build.directory}/jacoco-merged.exec</jacoco.check.dataFile>
    </properties>

    <dependencies>
        <!-- Project modules -->
        <dependency>
            <groupId>com.valadir</groupId>
            <artifactId>valadir-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.valadir</groupId>
            <artifactId>valadir-common</artifactId>
        </dependency>
        <!-- -->

        <!-- Spring Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT resource server (oauth2ResourceServer().jwt() DSL) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- spring-tx: DataAccessException, which GlobalExceptionHandler answers with a 503 when an
             adapter could not translate the outage itself. Declared here because it used to arrive
             transitively through the security module. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot testing features -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security testing features -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Mutation testing. Opt-in: ./mvnw -Pmutation test -->
        <profile>
            <id>mutation</id>
            <properties>
                <!-- PIT and JaCoCo both instrument bytecode; injecting the JaCoCo agent into
                     PIT's minion crashes it. Coverage and mutation are separate goals. -->
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <!-- Filters and error handling: plain unit tests, no Spring context.
                                 The controllers are left out because their @WebMvcTest slices would
                                 boot a context per mutant. -->
                            <targetClasses combine.self="override">
                                <param>com.valadir.web.filter.*</param>
                                <param>com.valadir.web.exception.*</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.valadir.web.filter.*</param>
                                <param>com.valadir.web.exception.*</param>
                            </targetTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
