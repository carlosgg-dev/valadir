<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.valadir</groupId>
        <artifactId>valadir</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>valadir-infrastructure-notifications</artifactId>

    <properties>
        <jacoco.check.phase>verify</jacoco.check.phase>
        <jacoco.check.dataFile>${project.build.directory}/jacoco-merged.exec</jacoco.check.dataFile>
    </properties>

    <dependencies>
        <!-- Project modules -->
        <dependency>
            <groupId>com.valadir</groupId>
            <artifactId>valadir-application</artifactId>
        </dependency>

        <dependency>
            <groupId>com.valadir</groupId>
            <artifactId>valadir-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- -->

        <!-- Spring Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Spring Boot testing features -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Thymeleaf: renders the mail bodies. Deliberately not spring-boot-starter-thymeleaf,
             which auto-configures an MVC ViewResolver this REST API has no use for. The engine is
             built explicitly in NotificationsWiring; the version comes from the Boot BOM. -->
        <dependency>
            <groupId>org.thymeleaf</groupId>
            <artifactId>thymeleaf-spring6</artifactId>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: runs Mailpit for the delivery IT -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Mutation testing. Opt-in: ./mvnw -Pmutation test -->
        <profile>
            <id>mutation</id>
            <properties>
                <!-- PIT and JaCoCo both instrument bytecode; injecting the JaCoCo agent into
                     PIT's minion crashes it. Coverage and mutation are separate goals. -->
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.valadir.notifications.mail.*</param>
                                <param>com.valadir.notifications.adapter.*</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.valadir.notifications.mail.*</param>
                                <param>com.valadir.notifications.adapter.*</param>
                            </targetTests>
                            <!-- The delivery IT sits in a scanned package: without this, every
                                 mutant would boot Mailpit. -->
                            <excludedTestClasses>
                                <param>com.valadir.notifications.*IT</param>
                            </excludedTestClasses>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
