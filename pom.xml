<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.valadir</groupId>
    <artifactId>valadir</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>valadir</name>
    <description>Valadir - Auth System</description>

    <modules>
        <module>valadir-application</module>
        <module>valadir-boot</module>
        <module>valadir-common</module>
        <module>valadir-domain</module>
        <module>valadir-infrastructure-notifications</module>
        <module>valadir-infrastructure-persistence</module>
        <module>valadir-infrastructure-security</module>
        <module>valadir-infrastructure-web</module>
        <module>valadir-test-support</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.encoding>UTF-8</project.encoding>
        <project.build.sourceEncoding>${project.encoding}</project.build.sourceEncoding>
        <project.reporting.outputEncoding>${project.encoding}</project.reporting.outputEncoding>
        <pitest.version>1.19.1</pitest.version>
        <pitest.junit5.version>1.2.2</pitest.junit5.version>
        <archunit.version>1.3.0</archunit.version>
        <resilience4j.version>2.3.0</resilience4j.version>

        <!-- JaCoCo agent argLines, populated at runtime by the prepare-agent goals.
             Declared empty so the build still works when JaCoCo is skipped (e.g. the
             `mutation` profile) instead of passing a literal `${...}` to the JVM. -->
        <surefireArgLine/>
        <failsafeArgLine/>

        <!-- Coverage gate defaults = strict unit gate (domain/application/common):
             `test` phase, unit-only exec, 100% branch+instruction. Infrastructure and
             boot modules override these to the union gate (`verify`, merged exec, 90%). -->
        <jacoco.check.phase>test</jacoco.check.phase>
        <jacoco.check.dataFile>${project.build.directory}/jacoco-unit.exec</jacoco.check.dataFile>
        <jacoco.coverage.minimum>1.00</jacoco.coverage.minimum>
    </properties>

    <dependencies>
        <!-- AssertJ: Fluent assertions for testing -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito: Mocking framework for unit tests -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter API for writing tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter Engine for running tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter Params for parameterized tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Project modules -->
            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-boot</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-domain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-infrastructure-notifications</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-infrastructure-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-infrastructure-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-infrastructure-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.valadir</groupId>
                <artifactId>valadir-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- -->

            <!-- Testcontainers: Library for using Docker containers in tests -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j: fault tolerance library providing circuit breakers -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- PIT: mutation testing. Shared config; only activated by the `mutation`
                     profile in the pure-logic modules (domain, application). -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest.junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>com.valadir.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>com.valadir.*</param>
                        </targetTests>
                        <outputFormats>
                            <value>HTML</value>
                            <value>XML</value>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <!-- 95 leaves headroom for legitimate future equivalent mutants without
                             masking real regressions -->
                        <mutationThreshold>95</mutationThreshold>
                    </configuration>
                    <executions>
                        <execution>
                            <id>mutation-coverage</id>
                            <phase>test</phase>
                            <goals>
                                <goal>mutationCoverage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Surefire: fast unit tests (*Test) in the `test` phase. Never boots Docker;
                 keeps the inner loop (`./mvnw test`) Testcontainers-free. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{...}: late property evaluation, resolved at test time so it picks up
                         the agent argLine set by jacoco prepare-agent (a plain ${...} would
                         resolve early to the empty default and the agent would never attach). -->
                    <argLine>@{surefireArgLine}</argLine>
                </configuration>
            </plugin>

            <!-- Failsafe: integration / E2E tests (*IT) in the `verify` phase. Everything that
                 boots Testcontainers lives here — slice and E2E share one execution bucket.
                 The integration-test+verify binding is inherited from spring-boot-starter-parent;
                 we only declare the plugin to activate it and inject the JaCoCo agent argLine. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{failsafeArgLine}</argLine>
                </configuration>
            </plugin>

            <!-- JaCoCo: two-exec, two-gate coverage attribution by test type.
                 Unit tests feed jacoco-unit.exec; integration/E2E feed jacoco-it.exec.
                 Coverage can never be inflated (masked) across test types. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <!-- Unit agent -> jacoco-unit.exec, wired into Surefire. -->
                    <execution>
                        <id>prepare-unit-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
                            <propertyName>surefireArgLine</propertyName>
                        </configuration>
                    </execution>

                    <!-- Integration agent -> jacoco-it.exec, wired into Failsafe. -->
                    <execution>
                        <id>prepare-it-agent</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>

                    <!-- Unit HTML report: what unit tests touch (diagnostic, per test type). -->
                    <execution>
                        <id>unit-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-unit.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>

                    <!-- Merge unit + integration into a single union exec for the verify gate.
                         Missing files (modules without *IT) are silently skipped. -->
                    <execution>
                        <id>merge-exec</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco-unit.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>

                    <!-- Integration HTML report: what integration/E2E tests touch. -->
                    <execution>
                        <id>integration-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-it.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-it</outputDirectory>
                        </configuration>
                    </execution>

                    <!-- Coverage gate. Phase, exec file and threshold vary by module via the jacoco.check.* properties:
                           - domain/application/common: `test`, jacoco-unit.exec, 100% (unit gate).
                             Integration tests are invisible to it -> un-inflatable.
                           - infrastructure-*/boot: `verify`, jacoco-merged.exec, 90% (union gate).
                             Declared after merge-exec so the merged file already exists at `verify`. -->
                    <execution>
                        <id>coverage-check</id>
                        <phase>${jacoco.check.phase}</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${jacoco.check.dataFile}</dataFile>
                            <!-- Spring wiring and entry point: no unit-testable logic -->
                            <excludes>
                                <exclude>**/*Wiring*</exclude>
                                <exclude>**/*Config*</exclude>
                                <exclude>**/ValadirApplication*</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
